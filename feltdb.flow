flow_version 1

// Authoritative declaration of Attn Invest's durable state (FeltDB 0.11.7).
// invest/store/store.ts loads this file; it does not keep its own list of collections or indexes.
// Records are validated in TypeScript at the application boundary; this file declares the collections,
// the fields the store filters on, and their indexes. Every record carries workspaceId.

app AttnInvest {
  collection investment_theses {
    workspaceId: text
    index workspaceId using hash(workspaceId)
  }
  collection thesis_versions {
    workspaceId: text
    thesisId: text
    index workspaceId using hash(workspaceId)
    index thesisId using hash(thesisId)
  }
  collection startups {
    workspaceId: text
    index workspaceId using hash(workspaceId)
  }
  collection documents {
    workspaceId: text
    startupId: text
    index workspaceId using hash(workspaceId)
    index startupId using hash(startupId)
  }
  collection document_pages {
    workspaceId: text
    documentId: text
    index workspaceId using hash(workspaceId)
    index documentId using hash(documentId)
  }
  collection evidence_items {
    workspaceId: text
    startupId: text
    documentId: text
    index workspaceId using hash(workspaceId)
    index startupId using hash(startupId)
    index documentId using hash(documentId)
  }
  collection evaluations {
    workspaceId: text
    startupId: text
    status: text
    index workspaceId using hash(workspaceId)
    index startupId using hash(startupId)
    index status using hash(status)
  }
  collection criterion_findings {
    workspaceId: text
    evaluationId: text
    index workspaceId using hash(workspaceId)
    index evaluationId using hash(evaluationId)
  }
  collection review_actions {
    workspaceId: text
    evaluationId: text
    index workspaceId using hash(workspaceId)
    index evaluationId using hash(evaluationId)
  }
  collection investment_decisions {
    workspaceId: text
    evaluationId: text
    startupId: text
    index workspaceId using hash(workspaceId)
    index evaluationId using hash(evaluationId)
    index startupId using hash(startupId)
  }
  collection audit_events {
    workspaceId: text
    eventType: text
    index workspaceId using hash(workspaceId)
    index eventType using hash(eventType)
  }
  collection investor_firms {
    workspaceId: text
    index workspaceId using hash(workspaceId)
  }
  collection research_runs {
    workspaceId: text
    firmId: text
    index workspaceId using hash(workspaceId)
    index firmId using hash(firmId)
  }
  collection research_sources {
    workspaceId: text
    firmId: text
    index workspaceId using hash(workspaceId)
    index firmId using hash(firmId)
  }
  collection research_criteria {
    workspaceId: text
    firmId: text
    index workspaceId using hash(workspaceId)
    index firmId using hash(firmId)
  }
  collection criterion_verifications {
    workspaceId: text
    firmId: text
    index workspaceId using hash(workspaceId)
    index firmId using hash(firmId)
  }
  collection research_reviews {
    workspaceId: text
    firmId: text
    index workspaceId using hash(workspaceId)
    index firmId using hash(firmId)
  }
  collection firm_approvals {
    workspaceId: text
    firmId: text
    index workspaceId using hash(workspaceId)
    index firmId using hash(firmId)
  }
  collection monitoring_targets {
    workspaceId: text
    firmId: text
    index workspaceId using hash(workspaceId)
    index firmId using hash(firmId)
  }
  collection source_states {
    workspaceId: text
    firmId: text
    index workspaceId using hash(workspaceId)
    index firmId using hash(firmId)
  }
  collection investment_events {
    workspaceId: text
    firmId: text
    index workspaceId using hash(workspaceId)
    index firmId using hash(firmId)
  }
  collection event_evidence {
    workspaceId: text
    firmId: text
    eventId: text
    index workspaceId using hash(workspaceId)
    index firmId using hash(firmId)
    index eventId using hash(eventId)
  }
  collection research_findings {
    workspaceId: text
    firmId: text
    index workspaceId using hash(workspaceId)
    index firmId using hash(firmId)
  }
  collection curated_sources {
    workspaceId: text
    index workspaceId using hash(workspaceId)
  }
  collection source_runs {
    workspaceId: text
    sourceId: text
    index workspaceId using hash(workspaceId)
    index sourceId using hash(sourceId)
  }
  collection source_snapshots {
    workspaceId: text
    sourceId: text
    index workspaceId using hash(workspaceId)
    index sourceId using hash(sourceId)
  }
  collection source_records {
    workspaceId: text
    sourceId: text
    externalId: text
    index workspaceId using hash(workspaceId)
    index sourceId using hash(sourceId)
    index externalId using hash(externalId)
  }
  collection entities {
    workspaceId: text
    key: text
    domain: text
    index workspaceId using hash(workspaceId)
    index key using hash(key)
    index domain using hash(domain)
  }
  collection entity_matches {
    workspaceId: text
    recordId: text
    index workspaceId using hash(workspaceId)
    index recordId using hash(recordId)
  }
  collection match_decisions {
    workspaceId: text
    matchId: text
    recordId: text
    index workspaceId using hash(workspaceId)
    index matchId using hash(matchId)
    index recordId using hash(recordId)
  }
  collection claims {
    workspaceId: text
    firmId: text
    index workspaceId using hash(workspaceId)
    index firmId using hash(firmId)
  }
  collection representative_claims {
    workspaceId: text
    canonicalDomain: text
    principalId: text
    index workspaceId using hash(workspaceId)
    index canonicalDomain using hash(canonicalDomain)
    index principalId using hash(principalId)
  }
  collection claim_events {
    workspaceId: text
    claimId: text
    index workspaceId using hash(workspaceId)
    index claimId using hash(claimId)
  }
  collection contributions {
    workspaceId: text
    chainId: text
    firmDomain: text
    index workspaceId using hash(workspaceId)
    index chainId using hash(chainId)
    index firmDomain using hash(firmDomain)
  }
  collection contribution_shares {
    workspaceId: text
    chainId: text
    index workspaceId using hash(workspaceId)
    index chainId using hash(chainId)
  }
  collection published_profiles {
    workspaceId: text
    canonicalDomain: text
    index workspaceId using hash(workspaceId)
    index canonicalDomain using hash(canonicalDomain)
  }
  collection contribution_responses {
    workspaceId: text
    chainId: text
    index workspaceId using hash(workspaceId)
    index chainId using hash(chainId)
  }
}
