# Attn Invest — example configuration (non-secret). Copy to invest/.env.local (git-ignored),
# fill in, and load it into the environment. Secrets belong in the environment or the
# deployment secret manager, never in this file, FeltDB, or the web bundle.

APP_ENV=development
LOG_LEVEL=info
INVEST_PORT=3100

# FeltDB 0.11.7 file runtime. A directory, separate from Attn's working-world store.
FELTDB_DIR=
# FeltDB adoption telemetry (anonymous, to feltdb.com) is off unless set to 1.
FELTDB_TELEMETRY=0
# Accepted for forward compatibility; the file runtime has no config file and ignores it.
FELTDB_CONFIG_PATH=

# AppPort contract generation (manifest + typed client); runtime binding is /appport.
APPPORT_CONFIG_PATH=invest/appport.config.ts

# AuthBoundry adapter: JSON principal registry (workspaces, principals with role and tokenSha256).
# Required in production. Without it, development uses one principal with token "dev-partner-token".
AUTHBOUNDRY_CONFIG_PATH=

# Jev HTTP decision endpoint (JevDecisionRequest → JevDecisionResponse). Unset = semantic criteria
# are recorded as evaluation_failed. JEV_PROVIDER / JEV_MODEL are recorded in every manifest.
JEV_ENDPOINT=
JEV_PROVIDER=
JEV_MODEL=
JEV_TIMEOUT_MS=30000
# JEV_API_KEY=            (secret — set in the environment only)

# Private document storage (content-addressed, 0700/0600).
DOCUMENT_STORAGE_DIR=
# DOCUMENT_STORAGE_LINK_SECRET=   (secret, ≥16 chars — required in production)
DOCUMENT_MAX_BYTES=20971520
DOCUMENT_ALLOWED_TYPES=application/pdf
DOCUMENT_MAX_PAGES=300
DOCUMENT_PARSE_TIMEOUT_MS=30000

EVALUATION_TIMEOUT_MS=120000
EVALUATION_MAX_RETRIES=2

# Investor research pipeline (bounded, same-domain, robots-respecting). Ceilings: pages 50, depth 4, retries 4.
RESEARCH_MAX_PAGES=12
RESEARCH_MAX_DEPTH=2
RESEARCH_TIMEOUT_MS=10000
RESEARCH_RETRIES=2
RESEARCH_DOMAIN_DELAY_MS=1500
RESEARCH_MAX_BYTES=1500000
RESEARCH_MAX_REDIRECTS=3
RESEARCH_STALE_AFTER_DAYS=180
# RESEARCH_CONTACT=https://your-fund.example/contact   (appended to the User-Agent so site owners can reach you)
RESEARCH_STALE_SOURCE_DAYS=14
RESEARCH_ANNOUNCEMENT_LOOKBACK_DAYS=730

# Continuous monitoring. The schedule is persisted in FeltDB; the in-server runner only wakes up to do due work.
# Off by default: nothing crawls until you opt in. `bun run monitor -- run` always works on demand.
MONITORING_ENABLED=0
MONITORING_INTERVAL_MINUTES=1440
MONITORING_MAX_CONCURRENT_FIRMS=2
MONITORING_LEASE_MINUTES=15
MONITORING_RETRY_BASE_MINUTES=30
